--- a/chrome/browser/themes/theme_service.cc
+++ b/chrome/browser/themes/theme_service.cc
@@ -330,8 +330,28 @@
   registry->RegisterBooleanPref(prefs::kBrowserFollowsSystemThemeColors,
                                 BUILDFLAG(IS_CHROMEOS));
   registry->RegisterStringPref(prefs::kSavedLocalTheme, "");
+  // Leanium: set once the Leanium accent replaced the grayscale default.
+  registry->RegisterBooleanPref("leanium.theme.accent_applied", false);
 }
 
+namespace {
+
+// Leanium: the accent colour of the cup logo (#B048C4, its most common colour)
+// as a vibrant user-colour theme: the active tab, focus rings and toggles use
+// it, and the frame gets a soft purple tint.
+void ApplyLeaniumAccentTheme(PrefService* pref_service) {
+  pref_service->SetBoolean(prefs::kGrayscaleThemeEnabled, false);
+  pref_service->SetInteger(
+      prefs::kUserColor, static_cast<int>(SkColorSetRGB(0xB0, 0x48, 0xC4)));
+  pref_service->SetInteger(
+      prefs::kBrowserColorVariant,
+      static_cast<int>(ui::mojom::BrowserColorVariant::kVibrant));
+  pref_service->SetString(prefs::kCurrentThemeID,
+                          ThemeService::kUserColorThemeID);
+}
+
+}  // namespace
+
 ThemeService::ThemeService(Profile* profile, const ThemeHelper& theme_helper)
     : profile_(profile),
       theme_helper_(theme_helper),
@@ -346,10 +366,24 @@
