+  PrefService* const pref_service = profile_->GetPrefs();
+  // Leanium: new profiles get the Leanium accent instead of Helium's grayscale.
+  // A profile that still uses that grayscale default is moved to the accent
+  // once (a colour or extension theme the user picked is left alone).
+  const std::string theme_id = pref_service->GetString(prefs::kCurrentThemeID);
+  const bool new_profile_default =
+      profile_->IsNewProfile() &&
+      !pref_service->HasPrefPath(prefs::kCurrentThemeID) &&
+      !pref_service->HasPrefPath(prefs::kGrayscaleThemeEnabled);
+  const bool grayscale_default =
+      !pref_service->GetBoolean("leanium.theme.accent_applied") &&
+      pref_service->GetBoolean(prefs::kGrayscaleThemeEnabled) &&
+      (theme_id.empty() || theme_id == kUserColorThemeID);
+  if (!UsingPolicyTheme()) {
+    if (new_profile_default || grayscale_default) {
+      ApplyLeaniumAccentTheme(pref_service);
+    }
+    pref_service->SetBoolean("leanium.theme.accent_applied", true);
   }
 
   InitFromPrefs();
