     : pref_service_(pref_service),
       scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
                                 *this) {
+  // Leanium: move a profile that is still on the classic layout to the compact
+  // single top bar once. Choosing Classic again in Settings is kept afterwards.
+  static constexpr char kLeaniumCompactLayoutApplied[] =
+      "leanium.browser.compact_layout_applied";
+  if (pref_service_->FindPreference(kLeaniumCompactLayoutApplied) &&
+      !pref_service_->GetBoolean(kLeaniumCompactLayoutApplied)) {
+    pref_service_->SetBoolean(kLeaniumCompactLayoutApplied, true);
+    if (GetBrowserLayout() == HeliumLayoutType::kClassic) {
+      SetBrowserLayout(HeliumLayoutType::kCompact);
+    }
+  }
